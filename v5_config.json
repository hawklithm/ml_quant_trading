{
  "_version": "v5.2",
  "_description": "量化选股系统可调优参数 — 修改此文件后无需改动 .py 源码",
  "ml_scoring": {
    "top_n": 20,
    "min_trading_days": 200,
    "test_splits": 3,
    "forecast_horizon_short": 21,
    "forecast_horizon_long": 21,
    "forecast_horizon_mom": 63,
    "warmup": 30,
    "adaptive_windows": [
      504,
      756,
      1008
    ],
    "cache_ttl_hours": 12,
    "cache_refresh_hours": 8,
    "score_formula": {
      "rank_weight": 0.85,
      "confidence_weight": 0.08
    },
    "sentiment": {
      "weight": 0.15,
      "event_discount_base": 0.85,
      "event_min_keep": 0.1,
      "event_direction_penalty": 0.3
    },
    "direction_thresholds": {
      "bullish": 0.3,
      "bearish": -0.25
    },
    "momentum_fallback": {
      "mom_21d_weight": 0.6,
      "mom_63d_weight": 0.4,
      "mom_score_offset": 0.5,
      "r2_to_weight_multiplier": 0.5,
      "weight_min": 0.1,
      "weight_max": 0.5
    },
    "classification": {
      "min_samples": 20,
      "min_accuracy": 0.2
    },
    "confidence": {
      "default_fallback": 0.3,
      "min_confidence": 0.2
    },
    "market_regime": {
      "enabled": true,
      "adx_threshold_trend": 25,
      "adx_threshold_strong_trend": 35,
      "bb_width_percentile_high": 0.8,
      "bb_width_percentile_low": 0.2,
      "mean_reversion_mom_weight_mult": 0.5,
      "mean_reversion_trend_weight_mult": 0.5,
      "strong_trend_mom_weight_mult": 1.3,
      "strong_trend_trend_weight_mult": 1.5,
      "high_vol_rsi_weight_mult": 1.2,
      "high_vol_mom_weight_mult": 0.6
    },
    "stock_penalty": {
      "enabled": true,
      "penalty_file": "~/.cache/hermes-quant/stock_penalties.json",
      "consecutive_failures_threshold": 2,
      "high_conf_threshold": 0.5,
      "max_penalty": 0.15,
      "penalty_per_failure": 0.04,
      "decay_days": 5
    },
    "score_spread": {
      "enabled": true,
      "method": "power",
      "power_exponent": 1.3,
      "min_score": 0.0,
      "max_score": 1.0
    },
    "sentiment_v2": {
      "enabled": true,
      "min_signal_threshold": 0.03,
      "strong_signal_threshold": 0.1,
      "base_weight": 0.15,
      "weak_signal_weight": 0.05,
      "strong_signal_weight": 0.3,
      "event_discount_base": 0.85,
      "event_min_keep": 0.1,
      "event_direction_penalty": 0.3
    }
  },
  "cross_validate": {
    "composite_weights": {
      "ml": 0.5,
      "factor": 0.3,
      "sentiment": 0.2
    },
    "dynamic_weight_decay": 0.7,
    "ml_weight_adj": {
      "base": 0.7,
      "confidence_scale": 0.3
    },
    "direction_bonus": {
      "enabled": true,
      "min_confidence": 0.3,
      "multiplier": 1.1
    },
    "confidence_composition": {
      "ml_confidence_weight": 0.4,
      "has_news_base": 0.3,
      "no_news_base": 0.1,
      "consensus_weight": 0.3
    },
    "levels": {
      "strong": 0.4,
      "strong_min_confidence": 0.4,
      "watch": 0.25,
      "watch_min_confidence": 0.3,
      "interest": 0.15
    }
  }
}